+++ b/hw/xbox/chihiro/chihiro-an2131.c
@@ -1174,12 +1174,28 @@ static void midi_rx_deliver(AN2131State *s)
     }
 
     Cpu8051State *cpu = &s->cpu;
+    /* V257 shares the SC drain/feeder path with the card UART. Do not post
+     * a steering RX interrupt while that USB drain owns its work pointers;
+     * the existing card path enforces the same boundary. Keep bytes queued. */
+    if (chihiro_cabinet_drive_board() == CHIHIRO_DRIVE_V257 &&
+        s->in_setup && !s->ep[0].in_armed) return;
     if (cpu->in_interrupt) return;
     if (cpu->sfr[0xC0 - 0x80] & 0x01) return;  /* RI1 still set */
 
     if (s->total_cycles - s->midi_response_set_cycles < 5000) return;
 
     uint8_t byte = midi_peer_get_response();
+#ifdef CHIHIRO_V257_TRACE
+    if (chihiro_cabinet_drive_board() == CHIHIRO_DRIVE_V257) {
+        static uint8_t frame[3]; static unsigned pos, frames;
+        frame[pos++]=byte;
+        if (pos==3) {
+            pos=0; unsigned n=++frames;
+            if (n<=12 || n%120==0 || frame[0]!='H')
+                fprintf(stderr,"[Chihiro V257 UART] n=%u bytes=%02X %02X %02X\n",n,frame[0],frame[1],frame[2]);
+        }
+    }
+#endif
     CHIHIRO_LOGF(FFB, "SC UART1 RX %02X\n", byte);
     cpu->events++;
     cpu->sfr[0xC1 - 0x80] = byte;
