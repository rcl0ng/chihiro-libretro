+RETRO_API bool retro_load_game(const struct retro_game_info *game)
+{
+    LRLOG_INFO("[xemu] retro_load_game called\n");
+
+    if (!game || !game->path) {
+        LRLOG_ERROR("[xemu] No game path provided\n");
+        return false;
+    }
+
+    LRLOG_INFO("[xemu] Loading game: %s\n", game->path);
+
+    if(emu_ever_started) { LRLOG_ERROR("[Chihiro] Restart RetroArch to load another game in this prototype\n"); return false; }
+
+    /* Read core options */
+    update_variables();
+
+    const char *save_directory=NULL;
+    if(environ_cb(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY,&save_directory) && save_directory && save_directory[0])
+        libretro_cards_set_directory(save_directory);
+    else
+        libretro_cards_set_directory(system_dir);
+    libretro_cards_load();
+    g_config.chihiro.card_reader.enable=true;
+    LRLOG_INFO("[Chihiro] Card directory base: %s\n",libretro_cards_directory());
+
+    /* Store the DVD path */
+    snprintf(opt_dvd_path, sizeof(opt_dvd_path), "%s", game->path);
+
+    /* Set shader cache base path */
+    if (system_dir[0]) {
+        char base_path[4096];
+        snprintf(base_path, sizeof(base_path), "%s/chihiro/", system_dir);
+        extern void libretro_settings_set_base_path(const char *path);
+        libretro_settings_set_base_path(base_path);
+        LRLOG_INFO("[xemu] Shader cache base path: %s\n", base_path);
+    }
+
+    if (!system_dir[0]) { LRLOG_ERROR("[Chihiro] System directory unavailable\n"); return false; }
+    static const char *names[] = {
+      "chihiro_xbox_bios.bin", "fpr21042_m29w160et.bin", "ic10_g24lc64.bin",
+      "ic11_24lc024.bin", "pc20_g24lc64.bin"
+    };
+    const char **paths[] = { &g_config.chihiro.roms.bios_path,
+      &g_config.chihiro.roms.mediaboard_path, &g_config.chihiro.roms.ic10_path,
+      &g_config.chihiro.roms.ic11_path, &g_config.chihiro.roms.pc20_path };
+    for (unsigned i=0;i<5;i++) {
+      char path[4096]; snprintf(path,sizeof(path),"%s/chihiro/%s",system_dir,names[i]);
+      FILE *f=fopen(path,"rb");
+      if(!f) { LRLOG_ERROR("[Chihiro] Missing firmware: %s\n",path); return false; }
+      fclose(f); xemu_settings_set_string(paths[i],path);
+    }
+    /* Optional native network firmware, used by OutRun 2 Special Tours. */
+    {
+      char path[4096];
+      snprintf(path,sizeof(path),"%s/chihiro/ver1305.bin",system_dir);
+      FILE *f=fopen(path,"rb");
+      xemu_settings_set_string(&g_config.chihiro.roms.net_firmware_path,
+                               f ? path : "");
+      if(f) { fclose(f); LRLOG_INFO("[Chihiro] Network firmware: %s\n",path); }
+    }
+    /* Query the frontend's preferred HW render context */
+    unsigned preferred_hw = RETRO_HW_CONTEXT_OPENGL_CORE;
+    if (environ_cb) {
+        environ_cb(RETRO_ENVIRONMENT_GET_PREFERRED_HW_RENDER, &preferred_hw);
+    }
+    LRLOG_INFO("[xemu] Frontend preferred HW render: %u\n", preferred_hw);
+
+    bool want_vulkan = (preferred_hw == RETRO_HW_CONTEXT_VULKAN);
+
+    /* Setup hardware rendering based on frontend preference */
+    memset(&hw_render, 0, sizeof(hw_render));
+    hw_render.context_reset      = context_reset;
+    hw_render.context_destroy    = context_destroy;
+    hw_render.depth              = true;
+    hw_render.stencil            = true;
+    hw_render.bottom_left_origin = true;
+    hw_render.cache_context      = true;
+
+    if (want_vulkan) {
+        LRLOG_INFO("[xemu] Requesting Vulkan HW context\n");
+        hw_render.context_type = RETRO_HW_CONTEXT_VULKAN;
+        hw_render.version_major = 1;
+        hw_render.version_minor = 3;
+    } else {
+        LRLOG_INFO("[xemu] Requesting OpenGL Core 4.0 HW context\n");
+        hw_render.context_type = RETRO_HW_CONTEXT_OPENGL_CORE;
+        hw_render.version_major = 4;
+        hw_render.version_minor = 1;
+    }
+
+    if (!environ_cb(RETRO_ENVIRONMENT_SET_HW_RENDER, &hw_render)) {
+        /* Preferred context failed - try the other one */
+        LRLOG_INFO("[xemu] Preferred context failed, trying fallback\n");
+        memset(&hw_render, 0, sizeof(hw_render));
+        hw_render.context_reset      = context_reset;
+        hw_render.context_destroy    = context_destroy;
+        hw_render.depth              = true;
+        hw_render.stencil            = true;
+        hw_render.bottom_left_origin = true;
+        hw_render.cache_context      = true;
+
+        if (want_vulkan) {
+            hw_render.context_type = RETRO_HW_CONTEXT_OPENGL_CORE;
+            hw_render.version_major = 4;
+            hw_render.version_minor = 1;
+            want_vulkan = false;
+        } else {
+            hw_render.context_type = RETRO_HW_CONTEXT_VULKAN;
+            hw_render.version_major = 1;
+            hw_render.version_minor = 3;
+            want_vulkan = true;
+        }
+
+        if (!environ_cb(RETRO_ENVIRONMENT_SET_HW_RENDER, &hw_render)) {
+            LRLOG_ERROR("[xemu] Failed to set HW render (neither GL nor VK available)\n");
+            return false;
+        }
+    }
+
+    use_vulkan = want_vulkan;
+    if (use_vulkan) {
+        LRLOG_INFO("[xemu] Using Vulkan HW rendering\n");
+    } else {
+        LRLOG_INFO("[xemu] Using OpenGL HW rendering\n");
+        environ_cb(RETRO_ENVIRONMENT_SET_HW_SHARED_CONTEXT, NULL);
+    }
+
+    /* Populate xemu config from core options */
+    populate_config(opt_dvd_path);
+
+    /* Context reset runs after load_game returns. Do not race the host's
+     * graphics setup with device threads creating their renderers. */
+    qatomic_set(&_emu_thread_running, false);
+    game_loaded = true;
+
+    LRLOG_INFO("[xemu] retro_load_game completed successfully\n");
+    return true;
+}
