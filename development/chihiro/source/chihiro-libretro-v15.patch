diff --git a/ui/xemu-vjoy-map.h b/ui/xemu-vjoy-map.h
new file mode 100644
index 0000000000..a9e2a11920
--- /dev/null
+++ b/ui/xemu-vjoy-map.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef XEMU_VJOY_MAP_H
+#define XEMU_VJOY_MAP_H
+#include <stdbool.h>
+#include <stdint.h>
+#include "hw/xbox/chihiro/chihiro-jvs.h"
+typedef struct {
+    uint16_t x, y;
+    bool valid, trigger, reload, body, pedal, start, coin;
+} VJoySample;
+typedef struct { bool coin[2], start[2]; } VJoyMap;
+/* Returns start/coin rising edges for logging. Keyboard start/service remain. */
+static inline unsigned vjoy_map(VJoyMap *map, ChihiroJVSState *jvs,
+                                unsigned p, VJoySample s)
+{
+    jvs->player_switches[p][0] &= ~(0x01 | 0x02);
+    jvs->player_switches[p][1] &= ~(0x80 | 0x40);
+    jvs->analog[p * 2] = jvs->analog[p * 2 + 1] = 0;
+    bool off = s.reload || s.x < 656 || s.x > 64879 ||
+               s.y < 656 || s.y > 64879;
+    if (s.valid) {
+        if (!off) { jvs->analog[p * 2] = s.x; jvs->analog[p * 2 + 1] = s.y; }
+        if (off) jvs->player_switches[p][0] |= 0x01;
+        if (s.trigger) jvs->player_switches[p][0] |= 0x02;
+        if (s.body) jvs->player_switches[p][1] |= 0x80;
+        if (s.pedal) jvs->player_switches[p][1] |= 0x40;
+        if (s.start) jvs->player_switches[p][0] |= 0x80;
+    }
+    bool coin = s.valid && s.coin, start = s.valid && s.start;
+    unsigned edges = 0;
+    if (coin && !map->coin[p]) { ++jvs->coin_count[p]; edges |= 2; }
+    if (start && !map->start[p]) edges |= 1;
+    map->coin[p] = coin; map->start[p] = start;
+    return edges;
+}
+#endif
diff --git a/util/defer-call.c b/util/defer-call.c
index 037dc0abf0..bc851d70dd 100644
--- a/util/defer-call.c
+++ b/util/defer-call.c
@@ -46,8 +46,23 @@ static void defer_call_atexit(Notifier *n, void *value)
     g_array_free(thread_state->deferred_call_array, TRUE);
 }
 
+#if defined(LIBRETRO) && defined(_WIN32)
+static DWORD tls_key_defer_call_atexit_notifier = TLS_OUT_OF_INDEXES;
+static inline Notifier *get_defer_call_atexit_notifier(void) {
+    if (tls_key_defer_call_atexit_notifier == TLS_OUT_OF_INDEXES)
+        tls_key_defer_call_atexit_notifier = TlsAlloc();
+    Notifier *p = (Notifier *)TlsGetValue(tls_key_defer_call_atexit_notifier);
+    if (!p) {
+        p = g_malloc0(sizeof(Notifier));
+        TlsSetValue(tls_key_defer_call_atexit_notifier, p);
+    }
+    return p;
+}
+#define defer_call_atexit_notifier (*get_defer_call_atexit_notifier())
