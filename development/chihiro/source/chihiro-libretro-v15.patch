diff --git a/ui/libretro-cards.c b/ui/libretro-cards.c
new file mode 100644
index 0000000000..61a5d6fe97
--- /dev/null
+++ b/ui/libretro-cards.c
@@ -0,0 +1,73 @@
+/* Persistent Ghost Squad and Maximum Tune card selections; GPL-2.0-or-later. */
+#include "qemu/osdep.h"
+#include "xemu-config.h"
+#include "libretro-cards.h"
+extern struct config g_config;
+extern void xemu_queue_notification_warning(const char *fmt, ...);
+static char directory[4096];
+static bool loaded;
+static const char *groups[]={"GhostSquad","GhostSquad","MaximumTune","MaximumTune"};
+static const char *keys[]={"p1","p2","mt1","mt2"};
+static const char **slot(unsigned p) {
+ switch(p) {
+ case 0:return &g_config.chihiro.card_reader.hw210.slot1;
+ case 1:return &g_config.chihiro.card_reader.hw210.slot2;
+ case 2:return &g_config.chihiro.card_reader.crp1231.mt1;
+ default:return &g_config.chihiro.card_reader.crp1231.mt2;
+ }
+}
+void libretro_cards_set_directory(const char *save_directory)
+{
+    snprintf(directory,sizeof(directory),"%s/chihiro/",save_directory);
+    if(g_mkdir_with_parents(directory,0755)!=0)
+        xemu_queue_notification_warning("Could not create card directory %s: %s",directory,strerror(errno));
+    fprintf(stderr,"[Chihiro cards] directory=%s\n",directory);
+}
+const char *libretro_cards_directory(void) { return directory; }
+void libretro_cards_load(void)
+{
+    if(loaded || !directory[0])return;
+    loaded=true;
+    char *manifest=g_build_filename(directory,"cards.ini",NULL);
+    GKeyFile *key=g_key_file_new();
+    if(g_key_file_load_from_file(key,manifest,G_KEY_FILE_NONE,NULL)) {
+        for(unsigned p=0;p<4;p++) {
+            char *name=g_key_file_get_string(key,groups[p],keys[p],NULL);
+            if(!name)continue;
+            char *base=g_path_get_basename(name);
+            if(name[0] && strcmp(base,name)==0 && strcmp(name,".") && strcmp(name,"..") && !g_path_is_absolute(name)) {
+                char *path=g_build_filename(directory,"cards",name,NULL);
+                if(g_file_test(path,G_FILE_TEST_IS_REGULAR)) {
+                    const char **selection=slot(p);
+                    free((void *)*selection);*selection=strdup(path);
+                }
+                g_free(path);
+            }
+            g_free(base);g_free(name);
+        }
+    }
+    for(unsigned p=2;p<4;p++)fprintf(stderr,"[Chihiro cards] loaded %s=%s\n",keys[p],*slot(p) ? *slot(p) : "(none)");
+    g_key_file_unref(key);g_free(manifest);
+}
+void libretro_cards_save(void)
+{
+    if(!directory[0])return;
+    GKeyFile *key=g_key_file_new();
+    for(unsigned p=0;p<4;p++) {
+        const char *path=*slot(p);
+        char *base=path && path[0] ? g_path_get_basename(path) : g_strdup("");
+        g_key_file_set_string(key,groups[p],keys[p],base);
+        g_free(base);
+    }
+    gsize length;char *data=g_key_file_to_data(key,&length,NULL);
+    char *manifest=g_build_filename(directory,"cards.ini",NULL);
+    GError *error=NULL;
+    if(!g_file_set_contents(manifest,data,length,&error)) {
+        xemu_queue_notification_warning("Could not save card selection: %s",error ? error->message : "unknown error");
+        g_clear_error(&error);
+    } else {
+        fprintf(stderr,"[Chihiro cards] saved selections to %s; mt1=%s mt2=%s\n",manifest,
+            *slot(2) ? *slot(2) : "", *slot(3) ? *slot(3) : "");
+    }
+    g_free(data);g_free(manifest);g_key_file_unref(key);
+}
