+ * @see RETRO_ENVIRONMENT_SET_CORE_OPTIONS_INTL
+ */
+#define RETRO_ENVIRONMENT_SET_CORE_OPTIONS 53
+
+/**
+ * A variant of \ref RETRO_ENVIRONMENT_SET_CORE_OPTIONS
