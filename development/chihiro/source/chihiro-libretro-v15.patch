+static const WideProfile profiles[] = {
+    {"OutRun 2","outrun2.xbe",or2_guards,G_N_ELEMENTS(or2_guards),or2_targets,G_N_ELEMENTS(or2_targets)},
+    {"OutRun 2 Special Tours","outrun2.xbe",sp_guards,G_N_ELEMENTS(sp_guards),sp_targets,G_N_ELEMENTS(sp_targets)},
+    {"Maximum Tune 1","V307.xbe",mt1_guards,G_N_ELEMENTS(mt1_guards),mt1_targets,G_N_ELEMENTS(mt1_targets)},
+    {"Maximum Tune 2","V322.xbe",mt2_guards,G_N_ELEMENTS(mt2_guards),mt2_targets,G_N_ELEMENTS(mt2_targets)},
+    {"Crazy Taxi High Roller","ctx_ac[r].xbe",ct3_guards,G_N_ELEMENTS(ct3_guards),ct3_targets,G_N_ELEMENTS(ct3_targets)},
+    {"Ollie King","OllieKing.xbe",ollie_guards,G_N_ELEMENTS(ollie_guards),ollie_targets,G_N_ELEMENTS(ollie_targets)},
+    {"Virtua Cop 3","vc3.xbe",vc3_guards,G_N_ELEMENTS(vc3_guards),vc3_targets,G_N_ELEMENTS(vc3_targets)},
+    {"Ghost Squad","vsg.xbe",gs_guards,G_N_ELEMENTS(gs_guards),gs_targets,G_N_ELEMENTS(gs_targets)},
+    {"The House of the Dead 3","hod3xb.xbe",hotd3_guards,G_N_ELEMENTS(hotd3_guards),hotd3_targets,G_N_ELEMENTS(hotd3_targets)},
+};
+static bool matches(ChihiroWideMemory mem,uint32_t va,const uint8_t *sig,uint32_t n)
+{
+    uint8_t have[32];
+    return n <= sizeof(have) && mem(va,have,n,false) && !memcmp(have,sig,n);
+}
+void libretro_widescreen_boot(const char *executable, ChihiroWideMemory mem)
+{
+    libretro_widescreen_reset();
+    if (!qatomic_read(&requested) || !executable) { return; }
+    const char *base=executable;
+    for (const char *p=executable; *p; p++) {
+        if (*p=='/' || *p=='\\') { base=p+1; }
+    }
+    bool candidate=false;
+    for (unsigned p=0;p<G_N_ELEMENTS(profiles);p++) {
+        const WideProfile *profile=&profiles[p];
+        if (g_ascii_strcasecmp(base,profile->executable)) { continue; }
+        candidate=true;
+        bool valid=true;
+        for (unsigned i=0;i<profile->guard_count;i++) {
+            const WideGuard *g=&profile->guards[i];
+            if (!matches(mem,g->va,g->bytes,g->size)) { valid=false; break; }
+        }
+        for (unsigned i=0;valid && i<profile->target_count;i++) {
+            const WideTarget *t=&profile->targets[i];
+            valid=matches(mem,t->va,t->original,4);
+        }
+        if (!valid) { continue; }
+        for (unsigned i=0;i<profile->target_count;i++) {
+            const WideTarget *t=&profile->targets[i];
+            if (!mem(t->va,(void *)t->wide,4,true) || !matches(mem,t->va,t->wide,4)) {
+                bool restored=true;
+                for (unsigned j=0;j<=i;j++) {
+                    const WideTarget *r=&profile->targets[j];
+                    bool wrote=mem(r->va,(void *)r->original,4,true);
+                    restored=wrote && matches(mem,r->va,r->original,4) && restored;
+                }
+                fprintf(stderr,"[Chihiro widescreen] %s write failed; rollback %s\n",profile->name,restored?"complete":"failed");
+                return;
+            }
+        }
+        qatomic_set(&active,true);
+        fprintf(stderr,"[Chihiro widescreen] %s 16:9 camera patch applied (%u values); image unchanged\n",profile->name,profile->target_count);
+        return;
+    }
+    if (candidate) {
+        fprintf(stderr,"[Chihiro widescreen] revision mismatch or unmapped; no patch applied\n");
+    }
+}
