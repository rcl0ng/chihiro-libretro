diff --git a/ui/libretro-input-descriptors.h b/ui/libretro-input-descriptors.h
new file mode 100644
index 0000000000..22ad45f286
--- /dev/null
+++ b/ui/libretro-input-descriptors.h
@@ -0,0 +1,40 @@
+/* Game-specific input descriptions, GPL-2.0-or-later. */
+#ifndef LIBRETRO_INPUT_DESCRIPTORS_H
+#define LIBRETRO_INPUT_DESCRIPTORS_H
+#define BUTTON(p,id,label) {p,RETRO_DEVICE_JOYPAD,0,RETRO_DEVICE_ID_JOYPAD_##id,label},
+#define AXIS(p,id,label) {p,RETRO_DEVICE_ANALOG,RETRO_DEVICE_INDEX_ANALOG_LEFT,RETRO_DEVICE_ID_ANALOG_##id,label},
+#define CABINET(p) BUTTON(p,START,"Start") BUTTON(p,SELECT,"Coin") BUTTON(p,L3,"Cabinet Test") BUTTON(p,R3,"Cabinet Service")
+#define GUN(p) AXIS(p,X,"Gun X") AXIS(p,Y,"Gun Y") BUTTON(p,B,"Trigger") CABINET(p)
+#define HOTD(p) GUN(p) BUTTON(p,A,"Shotgun Pump / Reload")
+#define VC3(p) GUN(p) BUTTON(p,A,"Offscreen Reload") BUTTON(p,X,"Gun Body Action") BUTTON(p,Y,"Pedal / Bullet Time")
+#define GS(p) GUN(p) BUTTON(p,A,"Offscreen Reload") BUTTON(p,X,"Gun Body Action") BUTTON(p,Y,"Weapon Change") BUTTON(p,UP,"Insert Card")
+#define DRIVING AXIS(0,X,"Steering") BUTTON(0,R2,"Accelerator") BUTTON(0,L2,"Brake") CABINET(0)
+static const struct retro_input_descriptor *chihiro_input_descriptors(int profile)
+{
+ static const struct retro_input_descriptor hotd[]={HOTD(0) HOTD(1) {0}};
+ static const struct retro_input_descriptor vc3[]={VC3(0) VC3(1) {0}};
+ static const struct retro_input_descriptor gs[]={GS(0) GS(1) {0}};
+ static const struct retro_input_descriptor ctx[]={DRIVING BUTTON(0,B,"Drive Gear (Latch)") BUTTON(0,A,"Reverse Gear (Latch)") BUTTON(0,Y,"Jump") {0}};
+ static const struct retro_input_descriptor ok[]={AXIS(0,X,"Board Swing") BUTTON(0,L2,"Front Foot Sensor") BUTTON(0,R2,"Rear Foot Sensor") BUTTON(0,UP,"Front Foot Sensor") BUTTON(0,DOWN,"Rear Foot Sensor") BUTTON(0,B,"Left Grab") BUTTON(0,A,"Right Grab") BUTTON(0,L,"Left Grab") BUTTON(0,R,"Right Grab") CABINET(0) {0}};
+ static const struct retro_input_descriptor mt[]={DRIVING BUTTON(0,L,"Gear Down (Latch)") BUTTON(0,R,"Gear Up (Latch)") BUTTON(0,Y,"View Change") BUTTON(0,X,"Intrude Change") BUTTON(0,UP,"Insert / Take Card") {0}};
+ static const struct retro_input_descriptor or2[]={DRIVING BUTTON(0,L,"Gear Down") BUTTON(0,R,"Gear Up") BUTTON(0,Y,"View Change") {0}};
+ switch(profile) {
+ case CONFIG_CHIHIRO_JVS_PROFILE_HOTD3:return hotd;
+ case CONFIG_CHIHIRO_JVS_PROFILE_VC3:return vc3;
+ case CONFIG_CHIHIRO_JVS_PROFILE_GS:return gs;
+ case CONFIG_CHIHIRO_JVS_PROFILE_CTX:return ctx;
+ case CONFIG_CHIHIRO_JVS_PROFILE_OK:return ok;
+ case CONFIG_CHIHIRO_JVS_PROFILE_WMMT2:return mt;
+ case CONFIG_CHIHIRO_JVS_PROFILE_OR2:return or2;
+ default:return NULL;
+ }
+}
+#undef DRIVING
