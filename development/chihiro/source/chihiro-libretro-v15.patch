diff --git a/ui/libretro-gun.c b/ui/libretro-gun.c
new file mode 100644
index 0000000000..0a7c1bd4ce
--- /dev/null
+++ b/ui/libretro-gun.c
@@ -0,0 +1,228 @@
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include <math.h>
+#include "libretro-gun.h"
+#include "xemu-config.h"
+#include "hw/xbox/chihiro/chihiro.h"
+#include "hw/xbox/chihiro/chihiro-jvs.h"
+#include "xemu-vjoy-map.h"
+#include "libretro-crosshair.h"
+#include "hw/xbox/chihiro/chihiro-driveboard-v257.h"
+#ifdef CHIHIRO_V257_TRACE
+#include "system/memory.h"
+static bool mt_guest_read(uint32_t va,void *out,unsigned length) {
+ unsigned char *p=out;
+ while(length) {
+  uint32_t pa=chihiro_va_to_pa(va);
+  if(pa==0xffffffff)return false;
+  unsigned n=MIN(length,4096-(va&4095));
+  cpu_physical_memory_read(pa,p,n);va+=n;p+=n;length-=n;
+ }
+ return true;
+}
+static void mt_guest_trace(void) {
+ /* Addresses/signature verified against the supplied V307.xbe. This
+  * observes guest RAM only; no executable or guest data is modified. */
+ static const uint8_t expected[8]={0x80,0xb9,0x24,0x7b,0,0,0x48,0x75};
+ uint8_t signature[8],frame[3],center[2];
+ uint32_t cached,decoded;
+ if(!mt_guest_read(0x6f3c0,signature,sizeof(signature)) || memcmp(signature,expected,sizeof(expected)))return;
+ bool ok=mt_guest_read(0x24496c,frame,3) && mt_guest_read(0x23ef1a,center,2) &&
+         mt_guest_read(0x23ce70,&cached,4) && mt_guest_read(0x247460,&decoded,4);
+ if(ok)fprintf(stderr,"[Chihiro MT1 guest] received=%02X %02X %02X test_cached=%u test_decoded=%u motor_center=%u\n",
+     frame[0],frame[1],frame[2],cached,decoded,(unsigned)center[0]|((unsigned)center[1]<<8));
+ /* Gameplay uses the JVS SDK's ADC buffer and saved pedal/wheel offsets,
+  * not the test-screen encoder decoder above. All reads remain signature-gated. */
+ uint32_t adc_ptr; uint8_t ports,channels,adc[6],cal[6];
+ if(mt_guest_read(0x399639,&ports,1) && ports>=1 &&
+    mt_guest_read(0x399bd0,&adc_ptr,4) && adc_ptr &&
+    mt_guest_read(0x399beb,&channels,1) && channels>=3 &&
+    mt_guest_read(adc_ptr,adc,6) && mt_guest_read(0x23eec4,cal,6)) {
+  unsigned wheel=((unsigned)adc[0]<<8)|adc[1];
+  unsigned offset=(unsigned)cal[0]|((unsigned)cal[1]<<8);
+  fprintf(stderr,"[Chihiro MT1 gameplay] ADC_ptr=%08X wheel=%04X gas=%04X brake=%04X offsets=%04X,%04X,%04X wheel_minus_offset=%d\n",
+    adc_ptr,wheel,((unsigned)adc[2]<<8)|adc[3],((unsigned)adc[4]<<8)|adc[5],
+    offset,(unsigned)cal[2]|((unsigned)cal[3]<<8),(unsigned)cal[4]|((unsigned)cal[5]<<8),
+    (int)wheel-(int)offset);
+ }
+}
+#endif
+static uint64_t samples[2];
+static uint32_t pedals[2];
+static int detected_profile = -1;
+static bool cards_enabled = true, new_cards[3], card_keys[2];
+static bool forward_gear = true;
+static unsigned previous_gear, previous_shift;
+static unsigned mt_gear=1;
+static bool mt_card_key;
+extern struct config g_config;
+int libretro_input_profile(void) { return qatomic_read(&detected_profile); }
+void libretro_gun_cards(bool enabled,unsigned p,bool new_blank) {
+ qatomic_set(&cards_enabled,enabled);if(p<3)qatomic_set(&new_cards[p],new_blank);
+}
+static unsigned devices[2] = {RETRO_DEVICE_ANALOG_GUN, RETRO_DEVICE_ANALOG_GUN};
+static unsigned sizes[2] = {100, 100};
+static VJoyMap map;
+void libretro_gun_device(unsigned p, unsigned d) { if (p<2) qatomic_set(&devices[p], d); }
+void libretro_gun_scale(unsigned p, unsigned s) { if(p<2) qatomic_set(&sizes[p], MIN(s,300)); }
+void libretro_gun_poll(retro_input_state_t cb) {
+ if (!cb) return;
+ for(unsigned p=0;p<2;p++) {
+  unsigned dev=qatomic_read(&devices[p]);
+  bool valid=dev!=RETRO_DEVICE_NONE;
+  int16_t x=cb(p,RETRO_DEVICE_ANALOG,RETRO_DEVICE_INDEX_ANALOG_LEFT,RETRO_DEVICE_ID_ANALOG_X);
+  int16_t y=cb(p,RETRO_DEVICE_ANALOG,RETRO_DEVICE_INDEX_ANALOG_LEFT,RETRO_DEVICE_ID_ANALOG_Y);
+  unsigned buttons=0;
+  for(unsigned b=0;b<16;b++) if(valid && cb(p,RETRO_DEVICE_JOYPAD,0,b)) buttons|=1U<<b;
+  int lt=MAX(0,cb(p,RETRO_DEVICE_ANALOG,RETRO_DEVICE_INDEX_ANALOG_BUTTON,RETRO_DEVICE_ID_JOYPAD_L2));
+  int rt=MAX(0,cb(p,RETRO_DEVICE_ANALOG,RETRO_DEVICE_INDEX_ANALOG_BUTTON,RETRO_DEVICE_ID_JOYPAD_R2));
+  if(!lt && (buttons&(1U<<RETRO_DEVICE_ID_JOYPAD_L2)))lt=32767;
+  if(!rt && (buttons&(1U<<RETRO_DEVICE_ID_JOYPAD_R2)))rt=32767;
+  qatomic_set(&pedals[p],valid ? (uint32_t)(lt*65535/32767)|((uint32_t)(rt*65535/32767)<<16) : 0);
+  qatomic_set(&samples[p], ((uint64_t)valid<<48)|((uint64_t)buttons<<32)|
+             ((uint32_t)((int)y+32768)<<16)|(uint16_t)((int)x+32768));
+ }
+}
+static VJoySample decode(uint64_t v,int profile) {
+ unsigned b=v>>32;
+ return (VJoySample){.valid=(v>>48)&1,.x=v&65535,.y=(v>>16)&65535,
+ .trigger=(b>>RETRO_DEVICE_ID_JOYPAD_B)&1,
+ .reload=profile!=CONFIG_CHIHIRO_JVS_PROFILE_HOTD3 && ((b>>RETRO_DEVICE_ID_JOYPAD_A)&1),
+ .body=(b>>(profile==CONFIG_CHIHIRO_JVS_PROFILE_HOTD3 ? RETRO_DEVICE_ID_JOYPAD_A : RETRO_DEVICE_ID_JOYPAD_X))&1,
+ .pedal=(b>>RETRO_DEVICE_ID_JOYPAD_Y)&1,
+ .start=(b>>RETRO_DEVICE_ID_JOYPAD_START)&1,.coin=(b>>RETRO_DEVICE_ID_JOYPAD_SELECT)&1};
+}
+static void common_switches(ChihiroJVSState *j,unsigned p,uint64_t v) {
+ unsigned b=(v>>32)&65535;bool valid=(v>>48)&1;
+ if(!valid)b=0;
+ if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_START))j->player_switches[p][0]|=0x80;
+ if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_R3))j->player_switches[p][0]|=0x40;
+ if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_L3))j->system_switches|=0x80;
+ bool coin=(b&(1U<<RETRO_DEVICE_ID_JOYPAD_SELECT))!=0;
+ if(coin&&!map.coin[p])j->coin_count[p]++;
+ map.coin[p]=coin;
+}
+void libretro_gun_apply(void *opaque) {
+ (void)opaque;
+ ChihiroJVSState *j=chihiro_jvs_global;if(!j)return;
+ int profile=chihiro_detected_game_profile();
+ qatomic_set(&detected_profile,profile);
+ chihiro_card_ui_sync();
+ j->system_switches=0;
+ memset(j->player_switches,0,sizeof(j->player_switches));
+ if(profile==CONFIG_CHIHIRO_JVS_PROFILE_CTX || profile==CONFIG_CHIHIRO_JVS_PROFILE_OK || profile==CONFIG_CHIHIRO_JVS_PROFILE_WMMT2 || profile==CONFIG_CHIHIRO_JVS_PROFILE_OR2) {
+  uint64_t v=qatomic_read(&samples[0]);VJoySample s=decode(v,profile);
+  unsigned b=s.valid ? (v>>32)&65535 : 0;
+  uint32_t t=qatomic_read(&pedals[0]);
+  memset(j->analog,0,sizeof(j->analog));
+  common_switches(j,0,v);
+  if(profile==CONFIG_CHIHIRO_JVS_PROFILE_WMMT2 || profile==CONFIG_CHIHIRO_JVS_PROFILE_OR2) {
+   j->analog[0]=s.valid ? s.x : 32768;
+   j->analog[1]=t>>16;j->analog[2]=t&65535;
+   if(profile==CONFIG_CHIHIRO_JVS_PROFILE_WMMT2) {
+    const unsigned up=1U<<RETRO_DEVICE_ID_JOYPAD_R,down=1U<<RETRO_DEVICE_ID_JOYPAD_L;
+    unsigned shift=b&(up|down);
+    /* Hold the resulting H-pattern signal between button presses. */
+    if((shift&up)&&!(previous_shift&up)&&mt_gear<6)mt_gear++;
+    if((shift&down)&&!(previous_shift&down)&&mt_gear>0)mt_gear--;
+    previous_shift=shift;
+    static const uint8_t gate[7]={0,0xA0,0x60,0x80,0x40,0x90,0x50};
+    if(s.valid)j->player_switches[0][1]|=gate[mt_gear];
+    if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_Y))j->player_switches[0][1]|=0x02;
+    if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_X))j->player_switches[0][1]|=0x01;
+    if(chihiro_v257_global)v257_set_wheel(chihiro_v257_global,j->analog[0]>>6);
+#ifdef CHIHIRO_V257_TRACE
+    static unsigned trace_ticks;
+    if ((++trace_ticks % 120) == 0) {
+     V257DriveBoard *db=chihiro_v257_global;
+     fprintf(stderr,"[Chihiro steering] JVS=%04X encoder=%03X board=%s wheel=%03X state=%u motor=%u pending=%u wire=%u\n",
+      j->analog[0],j->analog[0]>>6,db ? "present" : "missing",db ? db->wheel : 0,
+      db ? db->state : 0,db ? db->motor_on : 0,
+      db ? (db->pending_tail+V257_MSG_SLOTS-db->pending_head)%V257_MSG_SLOTS : 0,
+      db ? (db->resp_tail+V257_RESP_SIZE-db->resp_head)%V257_RESP_SIZE : 0);
+     mt_guest_trace();
+    }
+#endif
+    bool card=(b&(1U<<RETRO_DEVICE_ID_JOYPAD_UP))!=0;
+    if(card&&!mt_card_key&&qatomic_read(&cards_enabled)) {
+     if(qatomic_read(&new_cards[2])&&!chihiro_crp1231_card_busy()) {
+      const char **slot=chihiro_crp1231_card_setting();free((void *)*slot);*slot=strdup("");
+     }
+     chihiro_crp1231_card_key();chihiro_card_ui_sync();
+    }
+    mt_card_key=card;
+   }else {
+    if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_Y))j->player_switches[0][0]|=0x10;
+    /* OR2's shifter physically lives on the second JVS switch word. */
+    if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_R))j->player_switches[1][0]|=0x20;
+    if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_L))j->player_switches[1][0]|=0x10;
+   }
+  } else if(profile==CONFIG_CHIHIRO_JVS_PROFILE_CTX) {
+   unsigned gear=b&((1U<<RETRO_DEVICE_ID_JOYPAD_B)|(1U<<RETRO_DEVICE_ID_JOYPAD_A));
+   if((gear&(1U<<RETRO_DEVICE_ID_JOYPAD_B))&&!(previous_gear&(1U<<RETRO_DEVICE_ID_JOYPAD_B)))forward_gear=true;
+   if((gear&(1U<<RETRO_DEVICE_ID_JOYPAD_A))&&!(previous_gear&(1U<<RETRO_DEVICE_ID_JOYPAD_A)))forward_gear=false;
+   previous_gear=gear;
+   j->analog[0]=s.valid ? s.x : 32768;
+   j->analog[1]=t>>16; j->analog[2]=t&65535;
+   if(s.valid)j->player_switches[0][0]|=forward_gear ? 0x20 : 0x10;
+   if(b&(1U<<RETRO_DEVICE_ID_JOYPAD_Y))j->player_switches[0][0]|=0x02;
+  } else {
+   /* Native cabinet reads left swing above centre, right below. */
+   j->analog[1]=s.valid ? MIN(65535,65536-(unsigned)s.x) : 32768;
+   if((t&65535)>8191 || (b&(1U<<RETRO_DEVICE_ID_JOYPAD_UP)))j->player_switches[0][0]|=0x20;
+   if((t>>16)>8191 || (b&(1U<<RETRO_DEVICE_ID_JOYPAD_DOWN)))j->player_switches[0][0]|=0x10;
+   if(b&((1U<<RETRO_DEVICE_ID_JOYPAD_B)|(1U<<RETRO_DEVICE_ID_JOYPAD_L)))j->player_switches[0][0]|=0x02;
+   if(b&((1U<<RETRO_DEVICE_ID_JOYPAD_A)|(1U<<RETRO_DEVICE_ID_JOYPAD_R)))j->player_switches[0][0]|=0x01;
+  }
+  return; /* Both are single-player cabinets; P2 cannot overwrite these axes. */
+ }
+ for(unsigned p=0;p<2;p++) {
+  uint64_t v=qatomic_read(&samples[p]);unsigned b=(v>>32)&65535;
+  VJoySample s=decode(v,profile);
+  vjoy_map(&map,j,p,s);
+  if(s.valid && ((b>>RETRO_DEVICE_ID_JOYPAD_L3)&1))j->system_switches|=0x80;
+  if(s.valid && ((b>>RETRO_DEVICE_ID_JOYPAD_R3)&1))j->player_switches[p][0]|=0x40;
+  bool card=s.valid && ((b>>RETRO_DEVICE_ID_JOYPAD_UP)&1);
+  if(profile==CONFIG_CHIHIRO_JVS_PROFILE_GS) {
+   if(card&&!card_keys[p]&&qatomic_read(&cards_enabled)) {
+    if(qatomic_read(&new_cards[p])&&!chihiro_card_reader_present(p)) {
+     const char **slot=p ? &g_config.chihiro.card_reader.hw210.slot2 : &g_config.chihiro.card_reader.hw210.slot1;
+     free((void *)*slot);*slot=strdup("");
+    }
+    chihiro_hw210_card_key(p);
+    chihiro_card_ui_sync();
+   }
+   if(chihiro_card_reader_present(p))j->player_switches[p][1]|=0x20;
+  }
+  card_keys[p]=card;
+ }
+}
+void libretro_gun_rects(unsigned w,unsigned h,
+ void (*rect)(void *,int,int,int,int,const float *),void *opaque) {
+ int profile=libretro_input_profile();
+ if(profile==CONFIG_CHIHIRO_JVS_PROFILE_CTX || profile==CONFIG_CHIHIRO_JVS_PROFILE_OK || profile==CONFIG_CHIHIRO_JVS_PROFILE_WMMT2 || profile==CONFIG_CHIHIRO_JVS_PROFILE_OR2)return;
+ for(unsigned p=0;p<2;p++) {
+  VJoySample s=decode(qatomic_read(&samples[p]),profile);
+  unsigned size=qatomic_read(&sizes[p]);
+  if(!size||!s.valid||s.x<656||s.x>64879||s.y<656||s.y>64879)continue;
+  float scale=size/100.0f * h/480.0f;
+  int cx=(uint64_t)s.x*w/65535,cy=(uint64_t)s.y*h/65535;
+  const CrosshairRect *rs=p ? crosshair_p2 : crosshair_p1;
+  unsigned n=p ? G_N_ELEMENTS(crosshair_p2) : G_N_ELEMENTS(crosshair_p1);
+  for(unsigned i=0;i<n;i++) {
+   int x=cx+(int)floorf((rs[i].x-55)*scale),y=cy+(int)floorf((rs[i].y-55.0f)*scale);
+   int right=cx+(int)ceilf((rs[i].x+rs[i].w-55)*scale),bottom=cy+(int)ceilf((rs[i].y+rs[i].h-55.0f)*scale);
+   x=MAX(x,0);y=MAX(y,0);right=MIN(right,(int)w);bottom=MIN(bottom,(int)h);
+   float color[4]={rs[i].r/255.f,rs[i].g/255.f,rs[i].b/255.f,1};
+   if(right>x&&bottom>y)rect(opaque,x,y,right-x,bottom-y,color);
+  }
+ }
+}
+
+void libretro_gun_diagnostics(retro_log_printf_t log) {
+ if(!log)return;
+ uint64_t a=qatomic_read(&samples[0]),b=qatomic_read(&samples[1]);
+ log(RETRO_LOG_INFO,"[Chihiro] profile=%d P1 xy=%u,%u buttons=%04x P2 xy=%u,%u buttons=%04x crosshair=%u%%,%u%%\n",
+  libretro_input_profile(),(unsigned)(a&65535),(unsigned)((a>>16)&65535),(unsigned)((a>>32)&65535),
+  (unsigned)(b&65535),(unsigned)((b>>16)&65535),(unsigned)((b>>32)&65535),qatomic_read(&sizes[0]),qatomic_read(&sizes[1]));
+}
